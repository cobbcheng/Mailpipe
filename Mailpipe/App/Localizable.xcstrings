    "Choose Get started to allow Mailpipe to share the subjects and bodies of new messages in the scope below with your agent for drafting. Attachment contents are excluded.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose Get started to allow Mailpipe to share the subjects and bodies of new messages in the scope below with your agent for drafting. Attachment contents are excluded."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击「开始使用」，即授权 Mailpipe 将以下范围内的新邮件主题和正文交给 Agent 写草稿。授权不含附件内容。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige Empezar para permitir que Mailpipe comparta con tu agente los asuntos y textos de los mensajes nuevos del ámbito indicado. Se excluye el contenido de los adjuntos."
          }
        }
      }
    },
