          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al continuar, Mailpipe usará tu cuenta de GitHub para leer los cambios en %1$@ y compartirlos con DeepSeek Harness para revisarlos y redactar la respuesta. El borrador sustituirá tu respuesta."
          }
        }
