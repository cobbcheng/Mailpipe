    },
    "For 15 minutes, record only Message-IDs matching the exact subject. The separate body test checks a synthetic marker and byte count. Data stays on this Mac. No model calls or mail changes.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For 15 minutes, record only Message-IDs matching the exact subject. The separate body test checks a synthetic marker and byte count. Data stays on this Mac. No model calls or mail changes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始后 15 分钟内，扩展仅记录下列精确主题的 Message-ID。正文实验另行授权；只检查合成正文标记与字节数。材料只留本机，不调用模型、不修改邮件。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante 15 minutos se registran solo los Message-ID del asunto exacto. La prueba de texto requiere permiso aparte y comprueba un marcador y el tamaño. Los datos quedan en el Mac, sin llamadas al modelo ni cambios en Mail."
          }
        }
      }
    },
    "For GitHub PR links, the agent can check public changes. Access through your GitHub account requires separate confirmation.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For GitHub PR links, the agent can check public changes. Access through your GitHub account requires separate confirmation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来信含 GitHub PR 链接时，Agent 可核对公开变更。使用你的 GitHub 账户读取变更，需要你另行确认。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El agente puede consultar cambios públicos de PR de GitHub. El acceso mediante tu cuenta requiere otra confirmación."
          }
        }
      }
    },
    "For example, reply in the sender’s language and use at most two paragraphs.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For example, reply in the sender’s language and use at most two paragraphs."
