    "Check Mail before trying again to avoid opening a duplicate compose window. Changes to the original or authorization require confirmation. Your edits were kept.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check Mail before trying again to avoid opening a duplicate compose window. Changes to the original or authorization require confirmation. Your edits were kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能确认撰写窗口。请先查看 Mail，避免重复创建；原邮件或授权变化时需重新确认。当前编辑已保留。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa Mail antes de reintentar para evitar otra ventana de redacción. Los cambios en el original o en el permiso requieren confirmación. Se conservaron tus cambios."
          }
        }
      }
    },
