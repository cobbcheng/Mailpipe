{
  "sourceLanguage": "en",
  "strings": {
    "%1$@ reply drafts are ready to review.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ reply drafts are ready to review."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有 %1$@ 封邮件的回复草稿待审阅。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay %1$@ borradores de respuesta listos para revisar."
          }
        }
      }
    },
    "%1$@ sends this content to %2$@. Mailpipe excludes attachment contents.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sends this content to %2$@. Mailpipe excludes attachment contents."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前配置由%1$@ 将这些内容发给%2$@。Mailpipe 不会向模型发送附件内容。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ envía este contenido a %2$@. Mailpipe excluye el contenido de los adjuntos."
          }
        }
      }
    },
    "%1$@ cannot verify PR changes. The new draft will replace your reply.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ cannot verify PR changes. The new draft will replace your reply."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 无法核对 PR 的代码变更。新草稿会替换当前回复。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ no puede verificar los cambios del PR. El nuevo borrador sustituirá tu respuesta."
          }
        }
      }
    },
    "(No subject)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "(No subject)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "（无主题）"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "(Sin asunto)"
          }
        }
      }
    },
    "1 reply draft is ready to review.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1 reply draft is ready to review."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有 1 封邮件的回复草稿待审阅。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay 1 borrador de respuesta listo para revisar."
          }
        }
      }
    },
    "A draft could not be saved. Review your edits before installing the update.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A draft could not be saved. Review your edits before installing the update."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有一封草稿保存失败。请先检查编辑内容，再安装更新。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar un borrador. Revisa los cambios antes de instalar la actualización."
          }
        }
      }
    },
    "Advanced diagnostics": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Advanced diagnostics"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高级诊断"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnóstico avanzado"
          }
        }
      }
    },
    "After revocation, the agent stops processing new mail. Existing drafts stay on this Mac.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After revocation, the agent stops processing new mail. Existing drafts stay on this Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撤销后，Agent 不再处理新来信。已有草稿仍可在本机查看。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al revocar el permiso, el agente deja de procesar correos nuevos. Los borradores se conservan en este Mac."
          }
        }
      }
    },
    "Agent draft": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent draft"
