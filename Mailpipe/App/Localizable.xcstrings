          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "授权后，%1$@ 会把 Apple Mail 各账户新来信的主题、正文和已保存的回复提示词发给 %2$@。填写主题可限定为完全匹配的来信。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con tu autorización, %1$@ envía a %2$@ el asunto y el cuerpo de los mensajes nuevos de todas tus cuentas de Apple Mail, junto con las instrucciones de respuesta que hayas guardado. Escribe un asunto para exigir una coincidencia exacta."
          }
        }
      }
