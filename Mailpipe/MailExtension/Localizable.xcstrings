    "The draft changed. Reopen this panel to review it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The draft changed. Reopen this panel to review it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "草稿已更改，请重新打开面板查看。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El borrador ha cambiado. Vuelve a abrir el panel para revisarlo."
          }
        }
      }
    },
    "The suggestion changed. Review it before copying.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The suggestion changed. Review it before copying."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "建议已更新，请检查后再复制。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sugerencia ha cambiado. Revísala antes de copiarla."
          }
        }
      }
    },
    "Use %@ to draft a new reply to the original message.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use %@ to draft a new reply to the original message."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 %@ 根据原邮件重新起草回复。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa %@ para redactar una nueva respuesta al mensaje original."
          }
        }
      }
