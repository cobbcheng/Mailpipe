          "stringUnit": {
            "state": "translated",
            "value": "查找草稿"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buscar borrador"
          }
        }
      }
    },
    "Generate Draft": {
      "extractionState": "manual",
      "localizations": {
        "en": {
