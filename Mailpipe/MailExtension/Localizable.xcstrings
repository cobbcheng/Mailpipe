{
  "sourceLanguage": "en",
  "strings": {
    "Check that Mailpipe is running and mail processing is authorized.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check that Mailpipe is running and mail processing is authorized."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查 Mailpipe 是否正在运行、邮件处理是否已获授权。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba que Mailpipe esté abierto y tenga autorización para procesar mensajes."
          }
        }
      }
    },
    "Copied. Paste in your Mail reply.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copied. Paste in your Mail reply."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已复制，可粘贴到 Mail 回复正文。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sugerencia copiada. Pégala en tu respuesta en Mail."
          }
        }
      }
    },
    "Copy reply": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy reply"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制回复"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiar respuesta"
          }
        }
      }
    },
    "Could not copy. Try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not copy. Try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能复制，请重试。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo copiar. Inténtalo de nuevo."
          }
        }
      }
    },
    "Could not shorten the suggestion. Your text is still here.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not shorten the suggestion. Your text is still here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能改写，已保留当前文字。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo acortar la sugerencia. Se ha conservado tu texto."
          }
        }
      }
    },
    "Loading suggestion…": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading suggestion…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在读取建议…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cargando la sugerencia…"
          }
        }
      }
    },
    "Mail could not identify the original message.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mail could not identify the original message."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mail 未能识别这封回复的原邮件。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mail no pudo identificar el mensaje original."
          }
        }
      }
    },
    "No reply suggestion is ready for this message.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No reply suggestion is ready for this message."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这封邮件还没有可用的回复建议。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay una sugerencia de respuesta para este mensaje."
          }
        }
      }
    },
    "Open Mailpipe, then reopen this panel.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Mailpipe, then reopen this panel."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请打开 Mailpipe，然后重新打开此面板。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Mailpipe y vuelve a abrir este panel."
          }
        }
      }
    },
    "Open a reply to see its suggestion.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open a reply to see its suggestion."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开一封回复即可查看建议。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre una respuesta para ver su sugerencia."
          }
        }
      }
    },
