    "The draft changed. Reopen this panel to review it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The draft changed. Reopen this panel to review it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "草稿已更改，请重新打开面板查看。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El borrador ha cambiado. Vuelve a abrir el panel para revisarlo."
          }
