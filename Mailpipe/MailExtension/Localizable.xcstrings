          "stringUnit": {
            "state": "translated",
            "value": "正在生成草稿…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Generando borrador…"
          }
        }
      }
    },
    "Loading suggestion…": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading suggestion…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在读取建议…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cargando la sugerencia…"
          }
        }
      }
    },
    "Mail could not identify the original message.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mail could not identify the original message."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mail 未能识别这封回复的原邮件。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mail no pudo identificar el mensaje original."
          }
        }
      }
    },
    "Mail could not provide a readable original message.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mail could not provide a readable original message."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mail 未能提供可读取的原邮件正文。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mail no pudo proporcionar el texto del mensaje original."
          }
        }
      }
    },
    "Mailpipe is already preparing a draft for this message.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mailpipe is already preparing a draft for this message."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mailpipe 正在为这封邮件准备草稿。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mailpipe ya está preparando un borrador para este mensaje."
          }
        }
      }
    },
    "No draft yet": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No draft yet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无草稿"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay borrador"
          }
        }
      }
    },
    "No reply suggestion is ready for this message.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No reply suggestion is ready for this message."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这封邮件还没有可用的回复建议。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay una sugerencia de respuesta para este mensaje."
          }
        }
      }
    },
    "Open Mailpipe, then reopen this panel.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Mailpipe, then reopen this panel."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请打开 Mailpipe，然后重新打开此面板。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Mailpipe y vuelve a abrir este panel."
          }
        }
      }
    },
    "Open a reply to see its suggestion.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open a reply to see its suggestion."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开一封回复即可查看建议。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre una respuesta para ver su sugerencia."
          }
        }
      }
    },
