{
  "sourceLanguage": "en",
  "strings": {
    "Check that Mailpipe is running and mail processing is authorized.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check that Mailpipe is running and mail processing is authorized."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查 Mailpipe 是否正在运行、邮件处理是否已获授权。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba que Mailpipe esté abierto y tenga autorización para procesar mensajes."
          }
        }
      }
    },
    "Copied. Paste in your Mail reply.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copied. Paste in your Mail reply."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已复制，可粘贴到 Mail 回复正文。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sugerencia copiada. Pégala en tu respuesta en Mail."
          }
        }
      }
    },
    "Copy reply": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy reply"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制回复"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiar respuesta"
          }
        }
      }
    },
    "Could not copy. Try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not copy. Try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能复制，请重试。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo copiar. Inténtalo de nuevo."
          }
        }
      }
    },
    "Could not generate the draft. Reopen the panel to check its status.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not generate the draft. Reopen the panel to check its status."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能生成草稿，请重新打开面板查看状态。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo generar el borrador. Vuelve a abrir el panel para consultar su estado."
          }
        }
      }
    },
    "Could not regenerate the suggestion. Your text is still here.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not regenerate the suggestion. Your text is still here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能重新生成回复，已保留当前文字。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo regenerar la respuesta. Se ha conservado tu texto."
          }
        }
      }
    },
    "Each message allows three regenerations.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each message allows three regenerations."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每封邮件最多可重新生成三次。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes regenerar la respuesta a cada mensaje hasta tres veces."
          }
        }
      }
    },
    "Find Draft": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find Draft"
          }
        },
