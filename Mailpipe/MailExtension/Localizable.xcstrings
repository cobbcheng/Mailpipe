      }
    },
    "The suggestion changed. Review it before copying.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The suggestion changed. Review it before copying."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "建议已更新，请检查后再复制。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sugerencia ha cambiado. Revísala antes de copiarla."
          }
